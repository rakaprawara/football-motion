[
 {
  "text": "THESE THREE|PLAYERS",
  "start": 0.0,
  "mode": "HOOK",
  "end": 0.733
 },
 {
  "text": "WERE ONCE|CALLED",
  "start": 0.733,
  "mode": "HOOK",
  "end": 1.567
 },
 {
  "text": "THE FUTURE|OF FOOTBALL\u2026",
  "start": 1.567,
  "mode": "HOOK",
  "end": 2.967
 },
 {
  "text": "BUT THEIR|CAREERS",
  "start": 2.967,
  "mode": "HOOK",
  "end": 4.2
 },
 {
  "text": "TOOK A|COMPLETELY",
  "start": 4.2,
  "mode": "HOOK",
  "end": 4.967
 },
 {
  "text": "DIFFERENT|TURN.",
  "start": 4.967,
  "mode": "HOOK",
  "end": 6.433
 },
 {
  "text": "AT JUST 17,",
  "start": 6.433,
  "mode": "BODY",
  "end": 7.4
 },
 {
  "text": "FEDERICO MACHEDA",
  "start": 7.4,
  "mode": "BODY",
  "end": 8.067
 },
 {
  "text": "BECAME A",
  "start": 8.067,
  "mode": "BODY",
  "end": 8.767
 },
 {
  "text": "MANCHESTER UNITED HERO,",
  "start": 8.767,
  "mode": "BODY",
  "end": 10.633
 },
 {
  "text": "SCORING A DRAMATIC",
  "start": 10.633,
  "mode": "BODY",
  "end": 11.433
 },
 {
  "text": "WINNER AGAINST",
  "start": 11.433,
  "mode": "BODY",
  "end": 12.133
 },
 {
  "text": "ASTON VILLA.",
  "start": 12.133,
  "mode": "BODY",
  "end": 13.333
 },
 {
  "text": "BUT AFTER THAT",
  "start": 13.333,
  "mode": "BODY",
  "end": 13.933
 },
 {
  "text": "UNFORGETTABLE MOMENT,",
  "start": 13.933,
  "mode": "BODY",
  "end": 15.467
 },
 {
  "text": "HE STRUGGLED",
  "start": 15.467,
  "mode": "BODY",
  "end": 15.9
 },
 {
  "text": "TO LIVE UP",
  "start": 15.9,
  "mode": "BODY",
  "end": 16.533
 },
 {
  "text": "TO THE HYPE",
  "start": 16.533,
  "mode": "BODY",
  "end": 16.967
 },
 {
  "text": "AND NEVER BECAME",
  "start": 16.967,
  "mode": "BODY",
  "end": 17.733
 },
 {
  "text": "THE SUPERSTAR",
  "start": 17.733,
  "mode": "BODY",
  "end": 18.233
 },
 {
  "text": "EVERYONE EXPECTED.",
  "start": 18.233,
  "mode": "BODY",
  "end": 19.8
 },
 {
  "text": "EVERTON ONCE BELIEVED",
  "start": 19.8,
  "mode": "BODY",
  "end": 20.667
 },
 {
  "text": "JACK RODWELL",
  "start": 20.667,
  "mode": "BODY",
  "end": 21.4
 },
 {
  "text": "COULD BECOME",
  "start": 21.4,
  "mode": "BODY",
  "end": 21.967
 },
 {
  "text": "ENGLAND'S NEXT",
  "start": 21.967,
  "mode": "BODY",
  "end": 22.633
 },
 {
  "text": "GREAT MIDFIELDER.",
  "start": 22.633,
  "mode": "BODY",
  "end": 23.867
 },
 {
  "text": "MANCHESTER CITY",
  "start": 23.867,
  "mode": "BODY",
  "end": 24.3
 },
 {
  "text": "SIGNED HIM",
  "start": 24.3,
  "mode": "BODY",
  "end": 24.767
 },
 {
  "text": "FOR MILLIONS,",
  "start": 24.767,
  "mode": "BODY",
  "end": 25.933
 },
 {
  "text": "BUT INJURIES",
  "start": 25.933,
  "mode": "BODY",
  "end": 26.767
 },
 {
  "text": "AND INCONSISTENT",
  "start": 26.767,
  "mode": "BODY",
  "end": 27.9
 },
 {
  "text": "PERFORMANCES",
  "start": 27.9,
  "mode": "BODY",
  "end": 28.533
 },
 {
  "text": "DERAILED HIS CAREER.",
  "start": 28.533,
  "mode": "BODY",
  "end": 29.4
 },
 {
  "text": "HE WENT FROM",
  "start": 29.4,
  "mode": "BODY",
  "end": 30.433
 },
 {
  "text": "ONE OF ENGLAND'S",
  "start": 30.433,
  "mode": "BODY",
  "end": 31.433
 },
 {
  "text": "BRIGHTEST PROSPECTS",
  "start": 31.433,
  "mode": "BODY",
  "end": 32.2
 },
 {
  "text": "TO A FORGOTTEN NAME.",
  "start": 32.2,
  "mode": "BODY",
  "end": 34.367
 },
 {
  "text": "SIR ALEX FERGUSON",
  "start": 34.367,
  "mode": "BODY",
  "end": 34.967
 },
 {
  "text": "REPORTEDLY CALLED",
  "start": 34.967,
  "mode": "BODY",
  "end": 36.033
 },
 {
  "text": "RAVEL MORRISON",
  "start": 36.033,
  "mode": "BODY",
  "end": 36.733
 },
 {
  "text": "ONE OF THE MOST",
  "start": 36.733,
  "mode": "BODY",
  "end": 37.633
 },
 {
  "text": "NATURALLY GIFTED",
  "start": 37.633,
  "mode": "BODY",
  "end": 38.5
 },
 {
  "text": "PLAYERS HE'D EVER SEEN.",
  "start": 38.5,
  "mode": "BODY",
  "end": 40.833
 },
 {
  "text": "HE HAD UNBELIEVABLE TALENT,",
  "start": 40.833,
  "mode": "BODY",
  "end": 42.633
 },
 {
  "text": "BUT OFF-FIELD PROBLEMS",
  "start": 42.633,
  "mode": "BODY",
  "end": 43.767
 },
 {
  "text": "AND INCONSISTENCY",
  "start": 43.767,
  "mode": "BODY",
  "end": 44.6
 },
 {
  "text": "STOPPED HIM FROM",
  "start": 44.6,
  "mode": "BODY",
  "end": 45.967
 },
 {
  "text": "REACHING HIS POTENTIAL.",
  "start": 45.967,
  "mode": "BODY",
  "end": 47.367
 },
 {
  "text": "THREE UNBELIEVABLE TALENTS\u2026",
  "start": 47.367,
  "mode": "BODY",
  "end": 48.867
 },
 {
  "text": "THREE CAREERS",
  "start": 48.867,
  "mode": "BODY",
  "end": 49.333
 },
 {
  "text": "THAT NEVER REACHED",
  "start": 49.333,
  "mode": "BODY",
  "end": 50.133
 },
 {
  "text": "THEIR POTENTIAL.",
  "start": 50.133,
  "mode": "BODY",
  "end": 51.267
 },
 {
  "text": "WHO DISAPPOINTED YOU",
  "start": 51.267,
  "mode": "BODY",
  "end": 52.333
 },
 {
  "text": "THE MOST?",
  "start": 52.333,
  "mode": "BODY",
  "end": 53.033
 }
]