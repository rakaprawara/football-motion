[
 {
  "text": "THESE THREE|PLAYERS",
  "start": 0.0,
  "mode": "HOOK",
  "end": 0.733
 },
 {
  "text": "WERE ONCE|CALLED",
  "start": 0.733,
  "mode": "HOOK",
  "end": 1.367
 },
 {
  "text": "THE FUTURE|OF FOOTBALL\u2026",
  "start": 1.367,
  "mode": "HOOK",
  "end": 2.433
 },
 {
  "text": "BUT THEIR|CAREERS",
  "start": 2.433,
  "mode": "HOOK",
  "end": 3.067
 },
 {
  "text": "TOOK A|COMPLETELY",
  "start": 3.067,
  "mode": "HOOK",
  "end": 3.867
 },
 {
  "text": "DIFFERENT|TURN.",
  "start": 3.867,
  "mode": "HOOK",
  "end": 4.933
 },
 {
  "text": "AT JUST 17,",
  "start": 4.933,
  "mode": "BODY",
  "end": 6.167
 },
 {
  "text": "FEDERICO MACHEDA",
  "start": 6.167,
  "mode": "BODY",
  "end": 6.867
 },
 {
  "text": "BECAME A",
  "start": 6.867,
  "mode": "BODY",
  "end": 7.433
 },
 {
  "text": "MANCHESTER UNITED HERO,",
  "start": 7.433,
  "mode": "BODY",
  "end": 9.1
 },
 {
  "text": "SCORING A DRAMATIC",
  "start": 9.1,
  "mode": "BODY",
  "end": 9.867
 },
 {
  "text": "WINNER AGAINST",
  "start": 9.867,
  "mode": "BODY",
  "end": 10.767
 },
 {
  "text": "ASTON VILLA.",
  "start": 10.767,
  "mode": "BODY",
  "end": 11.667
 },
 {
  "text": "BUT AFTER THAT",
  "start": 11.667,
  "mode": "BODY",
  "end": 12.167
 },
 {
  "text": "UNFORGETTABLE MOMENT,",
  "start": 12.167,
  "mode": "BODY",
  "end": 13.633
 },
 {
  "text": "HE STRUGGLED",
  "start": 13.633,
  "mode": "BODY",
  "end": 13.967
 },
 {
  "text": "TO LIVE UP",
  "start": 13.967,
  "mode": "BODY",
  "end": 14.6
 },
 {
  "text": "TO THE HYPE",
  "start": 14.6,
  "mode": "BODY",
  "end": 15.033
 },
 {
  "text": "AND NEVER BECAME",
  "start": 15.033,
  "mode": "BODY",
  "end": 15.733
 },
 {
  "text": "THE SUPERSTAR",
  "start": 15.733,
  "mode": "BODY",
  "end": 16.367
 },
 {
  "text": "EVERYONE EXPECTED.",
  "start": 16.367,
  "mode": "BODY",
  "end": 17.967
 },
 {
  "text": "EVERTON ONCE BELIEVED",
  "start": 17.967,
  "mode": "BODY",
  "end": 18.867
 },
 {
  "text": "JACK RODWELL",
  "start": 18.867,
  "mode": "BODY",
  "end": 19.633
 },
 {
  "text": "COULD BECOME",
  "start": 19.633,
  "mode": "BODY",
  "end": 20.167
 },
 {
  "text": "ENGLAND'S NEXT",
  "start": 20.167,
  "mode": "BODY",
  "end": 21.133
 },
 {
  "text": "GREAT MIDFIELDER.",
  "start": 21.133,
  "mode": "BODY",
  "end": 22.333
 },
 {
  "text": "MANCHESTER CITY",
  "start": 22.333,
  "mode": "BODY",
  "end": 22.767
 },
 {
  "text": "SIGNED HIM",
  "start": 22.767,
  "mode": "BODY",
  "end": 23.333
 },
 {
  "text": "FOR MILLIONS,",
  "start": 23.333,
  "mode": "BODY",
  "end": 23.933
 },
 {
  "text": "BUT INJURIES",
  "start": 23.933,
  "mode": "BODY",
  "end": 24.467
 },
 {
  "text": "AND INCONSISTENT",
  "start": 24.467,
  "mode": "BODY",
  "end": 25.3
 },
 {
  "text": "PERFORMANCES",
  "start": 25.3,
  "mode": "BODY",
  "end": 26.067
 },
 {
  "text": "DERAILED HIS CAREER.",
  "start": 26.067,
  "mode": "BODY",
  "end": 27.533
 },
 {
  "text": "HE WENT FROM",
  "start": 27.533,
  "mode": "BODY",
  "end": 27.967
 },
 {
  "text": "ONE OF ENGLAND'S",
  "start": 27.967,
  "mode": "BODY",
  "end": 28.733
 },
 {
  "text": "BRIGHTEST PROSPECTS",
  "start": 28.733,
  "mode": "BODY",
  "end": 29.5
 },
 {
  "text": "TO A FORGOTTEN NAME.",
  "start": 29.5,
  "mode": "BODY",
  "end": 31.367
 },
 {
  "text": "SIR ALEX FERGUSON",
  "start": 31.367,
  "mode": "BODY",
  "end": 32.067
 },
 {
  "text": "REPORTEDLY CALLED",
  "start": 32.067,
  "mode": "BODY",
  "end": 33.067
 },
 {
  "text": "RAVEL MORRISON",
  "start": 33.067,
  "mode": "BODY",
  "end": 33.733
 },
 {
  "text": "ONE OF THE MOST",
  "start": 33.733,
  "mode": "BODY",
  "end": 34.367
 },
 {
  "text": "NATURALLY GIFTED",
  "start": 34.367,
  "mode": "BODY",
  "end": 35.1
 },
 {
  "text": "PLAYERS HE'D EVER SEEN.",
  "start": 35.1,
  "mode": "BODY",
  "end": 36.533
 },
 {
  "text": "HE HAD UNBELIEVABLE TALENT,",
  "start": 36.533,
  "mode": "BODY",
  "end": 37.867
 },
 {
  "text": "BUT OFF-FIELD PROBLEMS",
  "start": 37.867,
  "mode": "BODY",
  "end": 38.967
 },
 {
  "text": "AND INCONSISTENCY",
  "start": 38.967,
  "mode": "BODY",
  "end": 39.667
 },
 {
  "text": "STOPPED HIM FROM",
  "start": 39.667,
  "mode": "BODY",
  "end": 40.833
 },
 {
  "text": "REACHING HIS POTENTIAL.",
  "start": 40.833,
  "mode": "BODY",
  "end": 42.033
 },
 {
  "text": "THREE UNBELIEVABLE TALENTS\u2026",
  "start": 42.033,
  "mode": "BODY",
  "end": 43.7
 },
 {
  "text": "THREE CAREERS",
  "start": 43.7,
  "mode": "BODY",
  "end": 44.333
 },
 {
  "text": "THAT NEVER REACHED",
  "start": 44.333,
  "mode": "BODY",
  "end": 45.133
 },
 {
  "text": "THEIR POTENTIAL.",
  "start": 45.133,
  "mode": "BODY",
  "end": 45.9
 },
 {
  "text": "WHO DISAPPOINTED YOU",
  "start": 45.9,
  "mode": "BODY",
  "end": 46.8
 },
 {
  "text": "THE MOST?",
  "start": 46.8,
  "mode": "BODY",
  "end": 47.533
 }
]